        card_path=card_path,
        css_path=css_path,
    )

#the orchestrator of the functions described above, called in the last line of this file; probably to make the file more readable and modular 
def main() -> None:
    parser = argparse.ArgumentParser(
        description="Call OpenWeather current weather API and export temp/feels_like/clouds to CSV."
    )
    parser.add_argument("--q", type=str, default="Seattle,US", help="City,country (example: London,uk)") #location query string 
    args = parser.parse_args()

    script_dir = Path(__file__).resolve().parent #finds the directory where a4_api_call (this file) lives 
    env_path = script_dir / ".env" #builds the path to .env so script can access the API key needed to fetch requested data 
    output_path = script_dir / "api_call_results.csv" #builds the path for the CSV output file in the same folder 

    api_key = load_openweather_api_key(env_path)#loads API key from .env 
    weather_data = fetch_weather(args.q, api_key) #calls the API for location specified by location query string, returns JSON response 
    write_results_to_csv(weather_data, output_path) #extracts fields requested and writes them to the new .csv file 

    print(f"Results written to: {output_path}") #print results in a new .csv file 


if __name__ == "__main__":
    main() #runs when the script is executed directly 
