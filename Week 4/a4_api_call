#!/usr/bin/env python3
import argparse
import csv
import json
import os
from pathlib import Path
from datetime import datetime, timedelta
from html import escape
from urllib.parse import urlencode
from urllib.error import HTTPError, URLError
from urllib.request import urlopen

# loads OpenWeather API from .env
def load_openweather_api_key(env_path: Path) -> str:
    """Load OPENWEATHER_API_KEY from a .env file without extra dependencies."""
    env_value = os.getenv("OPENWEATHER_API_KEY", "").strip() #checks if api key is available in this enviornment as variable (precedence over .env)
    if env_value: #if key variable exists, skips reading .env file to check for a key there 
        return env_value

    if not env_path.exists(): #checks for .env file 
        raise FileNotFoundError(f".env file not found at: {env_path}") #if no .env found, flags an error and stops running script

#reads .env file line by line and looks for the line that specifically identifies OPENWEATHER_API_KEY (to actually access the API)
    for raw_line in env_path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            # Allow commented key lines like "#OPENWEATHER_API_KEY=..."
            line = line.lstrip("#").strip() #was having trouble with this cuz i initially had a comment that described the file... took it out though, but this line says that it strips the # in front of comments so the script can read that line
            if not line:
                continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() == "OPENWEATHER_API_KEY": #here's the line that says it's looking for this specific api key 
            key_value = value.strip().strip("'\"") #cleans the value so there's no quotations around it 
            if key_value:
                return key_value

    raise ValueError("OPENWEATHER_API_KEY not found in .env file.") #error flag if a key isn't found 

#conversion because the raw temperature data from the API comes back in Kelvins, converted to Fahrenheit degrees to make it more readable
def kelvin_to_fahrenheit(k: float) -> float:
    return (k - 273.15) * 9.0 / 5.0 + 32.0

#the actual api request URL for OpenWeather 
def fetch_weather(q: str, api_key: str) -> dict:
    url = "https://api.openweathermap.org/data/2.5/weather" #the actual endpoint 
    params = urlencode(
        {
            "q": q, #the location query string (changed from the default London to Seattle)
            "appid": api_key, #the api key that'll return the decoded JSON response 
        }
    )
    request_url = f"{url}?{params}" #combines all parameters listed above into a single full request URL

#calls the OpenWeather URL and either returns the JSON data (as intended) or flags an error if network problems are encountered (great for debugging i had to do earlier)
    try:
        with urlopen(request_url, timeout=30) as response: #opens URL built earlier, gives up after 30 seconds 
            return json.loads(response.read().decode("utf-8")) #parses text into Python dictionary
    except HTTPError as e: #runs even if HTTP error status is encountered 
        body = e.read().decode("utf-8", errors="replace") if hasattr(e, "read") else ""
        raise RuntimeError(
            f"OpenWeather API request failed with HTTP {e.code}. "
            f"Response body: {body}"
        ) from e
    except URLError as e: #still runs if there's networking problems on a lower-level than HTTP status 
        raise RuntimeError(f"Network error while calling OpenWeather: {e}") from e

#takes the weather API responses (aka the payload) and writes the selected fields into CSV file (as requested) 
def write_results_to_csv(payload: dict, output_path: Path) -> None:
    city = payload.get("name") #city name
    main = payload.get("main", {}) 
    clouds = payload.get("clouds", {}) #clouds 

    temp_k = main.get("temp") #temperature in kelvins 
    feels_like_k = main.get("feels_like") #feel like temperature in kelvins 
    cloud_coverage = clouds.get("all") #cloud coverage 

#rounds converted values (from Kelvins to Fahrenheit) to the nearest whole number (again, to make these numbers more readable) 
    temp_f = round(kelvin_to_fahrenheit(temp_k)) if temp_k is not None else None
    feels_like_f = (
        round(kelvin_to_fahrenheit(feels_like_k)) if feels_like_k is not None else None
    )

    # /data/2.5/weather provides:
    # - dt: Unix time (seconds)
    # - timezone: offset in seconds from UTC
    dt_unix = payload.get("dt")
    tz_offset_seconds = payload.get("timezone")

#turns the API's timestamp info into human-readable local date/time, and a timezone string for the CSV 
    if dt_unix is not None:
        #this block is specifically for the timezone, converted ito something readable 
        base_utc = datetime.utcfromtimestamp(int(dt_unix))
        if tz_offset_seconds is not None:
            local_dt = base_utc + timedelta(seconds=int(tz_offset_seconds))
            total_minutes = int(tz_offset_seconds) // 60
            sign = "+" if total_minutes >= 0 else "-"
            total_minutes = abs(total_minutes)
            tz_hours = total_minutes // 60
            tz_minutes = total_minutes % 60
            tz_str = f"UTC{sign}{tz_hours:02d}:{tz_minutes:02d}"
        else: #if a timezone wasn't detected, leaves the datetime as UTC 
            local_dt = base_utc
            tz_str = "UTC"
    else: #if dt_unix aka the timestamp of the payload is missing, sets these variables to none
        local_dt = None
        tz_str = None

#actually writes the returned data as one row in the .csv file 
    with output_path.open("w", newline="", encoding="utf-8") as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow( #labels for each data point so you know what these numbers mean 
            ["city", "date", "time", "timezone", "temp_f", "feels_like_f", "clouds"]
        )
        writer.writerow( #actual returned values in the form of a list 
            [
                city,
                local_dt.strftime("%Y-%m-%d") if local_dt else None,
                local_dt.strftime("%H:%M:%S") if local_dt else None,
                tz_str,
                temp_f,
                feels_like_f,
                cloud_coverage,
            ]
        )

#visually represents the fetched data requested from the API into a readable and user friendly card (uses html and css) 
def write_weather_card(
